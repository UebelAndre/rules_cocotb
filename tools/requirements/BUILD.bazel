load("@rules_req_compile//:defs.bzl", "py_reqs_compiler", "py_reqs_solution_test")

exports_files(glob(["*.txt"]))

filegroup(
    name = "requirements_in",
    srcs = [
        "dev_requirements.in",
    ],
    data = [
        "//cocotb:requirements.in",
    ],
)

# One target compiles the solution of every platform, from any host. The
# solutions share the version of every package and record their platform
# tag in their header, which is how `MODULE.bazel` selects between them.
# Refresh with `bazel run //tools/requirements:requirements.update`
# (`-- --upgrade` to move every pin).
py_reqs_compiler(
    name = "requirements.update",
    requirements_in = ":requirements_in",
    requirements_txts = {
        "requirements_linux_x86_64.txt": "manylinux_2_28_x86_64",
        "requirements_macos_aarch64.txt": "macosx_11_0_arm64",
        "requirements_windows_x86_64.txt": "win_amd64",
    },
)

py_reqs_solution_test(
    name = "requirements_test",
    compiler = ":requirements.update",
)
